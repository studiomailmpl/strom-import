# STRØM Import — backend environment variables
# Kopiér til .env og udfyld værdierne. .env må ALDRIG committes.
# I produktion sættes disse som Railway env vars.

# --- App ---
DEBUG=
CORS_ORIGINS=

# --- Database (Neon PostgreSQL) ---
DATABASE_URL=
DATABASE_URL_SYNC=

# --- Auth (Clerk) ---
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=

# --- Anthropic (Claude Vision til faktura-analyse) ---
ANTHROPIC_API_KEY=

# --- Kryptering af OAuth-tokens ---
# Generér med: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Shopify OAuth ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=
SHOPIFY_APP_URL=
SHOPIFY_REDIRECT_URI=

# --- Google OAuth (Search Console) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Google Drive (samme OAuth-klient, egen redirect URI) ---
GOOGLE_DRIVE_REDIRECT_URI=

# --- DataForSEO (keyword volume + difficulty) ---
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- SerpAPI (Google Images fallback) ---
SERPAPI_KEY=

# --- Filhåndtering ---
UPLOAD_DIR=
IMAGE_UPLOAD_DIR=
MAX_UPLOAD_SIZE_MB=
MAX_IMAGE_SIZE_MB=
PUBLIC_BASE_URL=

# --- Shopify defaults ---
DEFAULT_EUR_RATE=
DEFAULT_MARKUP=

# --- Rate limiting ---
RATE_LIMIT_ANALYSE=
RATE_LIMIT_PUSH=
RATE_LIMIT_UPLOAD=
RATE_LIMIT_DEFAULT=
